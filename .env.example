# Server
PORT=8888
NODE_ENV=development
# URL ຂອງໄຟລ໌ upload ທີ່ສົ່ງກັບໃຫ້ໜ້າເວັບ — ຂຽນເລກ port ເຕັມ (.env ບໍ່ແທນຄ່າ $PORT ໃຫ້); ປະວ່າງ = http://localhost:<PORT>/image
IMAGE_URL=http://localhost:8888/image
# MySQL / MariaDB
DB_DIALECT=mysql
DB_NAME=bansi
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306
DB_CONNECT_TIMEOUT_MS=10000
DB_RETRY_DELAY_MS=5000

# JWT (ADMIN_JWT_* ກໍ່ໃຊ້ໄດ້ — ມາກ່ອນ JWT_*)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=Bansi-OAC
