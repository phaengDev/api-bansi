# Server
PORT=8888
NODE_ENV=development
# MySQL / MariaDB
DB_DIALECT=mysql
DB_NAME=bansi
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306
DB_CONNECT_TIMEOUT_MS=10000
DB_RETRY_DELAY_MS=5000

# JWT (ADMIN_JWT_* ກໍ່ໃຊ້ໄດ້ — ມາກ່ອນ JWT_*). ສ້າງໃໝ່ທຸກ server ດ້ວຍ `openssl rand -hex 32` — ຫ້າມ commit ຄ່າແທ້ເຂົ້າ git
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=Bansi-OAC

# SMS (Telbiz, https://telbiz.la) — OTP ລືມລະຫັດຜ່ານຂອງ app ພະນັກງານ. ບໍ່ຕັ້ງ = development ພິມ SMS ໃນ console
# ໃສ່ key ສະເພາະໃນ .env ເທົ່ານັ້ນ — ຫ້າມຂຽນໃນໂຄດ (utils/sms.ts ອ່ານຈາກນີ້)
TELBIZ_CLIENT_ID=
TELBIZ_SECRET=
TELBIZ_HEADER=OTP

# Firebase Cloud Messaging (ແຈ້ງເຕືອນເດັ້ງຂຶ້ນຈໍມືຖື, ຟຣີ) — ໄຟລ໌ service account ຈາກ Firebase Console
# (Project settings → Service accounts → Generate new private key). ປະວ່າງ = firebase-service-account.json ຂ້າງ package.json
# ບໍ່ມີໄຟລ໌ = ປິດການສົ່ງ (ແຈ້ງເຕືອນໃນແອັບຍັງເຮັດວຽກ)
FIREBASE_SERVICE_ACCOUNT=

# ອັບເດດແອັບ Android: Mac ທີ່ build ແອັບ ອັບໂຫຼດ APK ເອງ (tool/release_android.sh ຂອງ oacbroker) — ກະແຈລັບ ≥ 32 ຕົວ,
# ຄ່າດຽວກັບໄຟລ໌ ~/.oac/release_key ໃນ Mac ນັ້ນ. ບໍ່ຕັ້ງ = ປິດ (ອັບໂຫຼດໄດ້ທາງໜ້າເວັບເທົ່ານັ້ນ). ຫ້າມ commit ຄ່າແທ້
APP_RELEASE_KEY=

# ຜູ້ຊ່ວຍ AI ໃນເມນູແຜນວຽກ (Claude Opus 5.5) — API key ຈາກ platform.claude.com (ຈ່າຍຕາມການໃຊ້). ບໍ່ຕັ້ງ = ປິດຜູ້ຊ່ວຍ AI.
# AI_DAILY_LIMIT = ຈຳນວນຄຳຖາມຕໍ່ຄົນຕໍ່ມື້ (ຄ່າເລີ່ມຕົ້ນ 30). ຫ້າມ commit ຄ່າແທ້
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=30

# ອ່ານຄຳຕອບຂອງຜູ້ຊ່ວຍ AI ເປັນສຽງພາສາລາວ — Azure AI Speech (portal.azure.com → Speech service → Keys and Endpoint).
# ບໍ່ຕັ້ງ AZURE_SPEECH_KEY = ປິດ (ແອັບບໍ່ສະແດງປຸ່ມ 🔊). ສຽງ: lo-LA-KeomanyNeural (ຍິງ) / lo-LA-ChanthavongNeural (ຊາຍ)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=lo-LA-KeomanyNeural
AI_DAILY_SPEECH_CHARS=20000

# ສຽງເວົ້າ "ເຂົ້າວຽກຊ້າ / ອອກກ່ອນເວລາ … ນາທີ" ໃນແອັບ — Gemini TTS (aistudio.google.com/apikey, ມີແບບຟຣີ). ບໍ່ຕັ້ງ = ປິດ.
# ສຽງ: ຍິງ (gender 2) / ຊາຍ. ຫ້າມ commit ຄ່າແທ້
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE_FEMALE=Kore
GEMINI_VOICE_MALE=Charon
